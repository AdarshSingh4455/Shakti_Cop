# सर्वर
PORT=4000
NODE_ENV=development

# डेटाबेस (PostgreSQL)
DATABASE_URL=postgres://shaktikop_user:changeme@localhost:5432/shaktikop

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 🔒 Field-Level Encryption — संवेदनशील डेटाबेस कॉलम (जैसे पीड़ित का पता, पिता का नाम)
# डेटाबेस में plain text की जगह encrypted रूप में सेव होते हैं (देखें src/utils/fieldCrypto.js)।
# 32-byte key का hex रूप (64 hex characters) चाहिए। बनाने के लिए:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ यह key कभी git में commit न करें, और खोने पर पहले से encrypted डेटा हमेशा के लिए
# अपठनीय हो जाता है — इसे सुरक्षित तरीक़े से अलग बैकअप रखें (जैसे किसी secrets manager में)।
# पहले से मौजूद डेटा को encrypt करने के लिए (key सेट करने के बाद, एक बार):
#   npm run db:encrypt-fields
FIELD_ENCRYPTION_KEY=
# 🆕 Key Rotation (वैकल्पिक) — key बदलते समय, पुरानी key यहां डालें ताकि उससे
# encrypted हो चुका पुराना डेटा भी पढ़ा जाता रहे (नया डेटा हमेशा ऊपर वाली नई
# FIELD_ENCRYPTION_KEY से ही encrypt होता है)। पूरी प्रक्रिया के लिए src/utils/fieldCrypto.js
# के ऊपर की टिप्पणी देखें। पुराना डेटा दोबारा-encrypt (re-encrypt) करने के बाद इसे हटा दें।
FIELD_ENCRYPTION_KEY_PREVIOUS=

# OTP (नागरिक लॉगिन)
# OTP कितनी देर वैध रहे। 3 मिनट = हमलावर के पास अनुमान लगाने की खिड़की छोटी,
# पर SMS पहुँचने में लगने वाले सामान्य विलंब (नेटवर्क/गेटवे) के लिए पर्याप्त।
# इससे कम करने पर धीमे नेटवर्क वाले असली उपयोगकर्ता परेशान होने लगते हैं।
OTP_EXPIRY_MINUTES=3
# असली SMS गेटवे जुड़ने तक, dev मोड में OTP response में वापस भेजा जाता है ताकि टेस्ट किया जा सके।
OTP_DEV_MODE=true

# भविष्य में असली SMS गेटवे (जैसे MSG91 / Twilio) के लिए
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=SHKTCP

# Gmail SMTP से असली OTP ईमेल भेजने के लिए (nodemailer)
# ⚠️ यह आपका सामान्य Gmail पासवर्ड नहीं है — अलग से "App Password" बनानी होगी:
# 1. https://myaccount.google.com/security खोलें
# 2. "2-Step Verification" चालू करें (पहले से न हो तो)
# 3. "App passwords" खोजें → नया App Password बनाएं (नाम कुछ भी दें, जैसे "ShaktiCop")
# 4. जो 16-अक्षर का पासवर्ड मिले, वही नीचे डालें (स्पेस हटाकर)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# नज़दीकी थाना/अस्पताल खोजने के लिए — LocationIQ Nearby-POI API इस्तेमाल होती है
# (मुफ़्त 5,000 requests/day) — my.locationiq.com पर मुफ़्त account बनाकर API key लें।
# ⚠️ बिना इस key के "नज़दीकी सहायता" फ़ीचर काम नहीं करेगा।
LOCATIONIQ_API_KEY=

# CORS — ब्राउज़र से किन websites को API कॉल करने की अनुमति है (कॉमा से अलग)
# मोबाइल ऐप को इसकी ज़रूरत नहीं (वह Origin header नहीं भेजता)
# खाली छोड़ने पर सभी origins की अनुमति रहेगी (सिर्फ़ development के लिए ठीक)
ALLOWED_ORIGINS=

# Crash/Error Monitoring (Sentry) — sentry.io पर मुफ़्त account बनाकर Node.js
# project जोड़ें, मिला DSN यहां डालें। खाली छोड़ने पर कुछ नहीं होता (सिर्फ़
# console.error, जैसा पहले था) — production में सेट करना ज़ोरदार सुझाव है।
SENTRY_DSN=

# ============================================================
# SMS गेटवे — नीचे तीनों में से किसी एक की जानकारी भर दें,
# कोड अपने-आप उसी का इस्तेमाल करने लगेगा। कुछ बदलने की ज़रूरत नहीं।
# ============================================================

# विकल्प 1 — MSG91 (भारत में सबसे आम, DLT-अनुपालक)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SHKTCP
MSG91_TEMPLATE_ID=

# विकल्प 2 — Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=TXTIND

# विकल्प 3 — Twilio (अंतरराष्ट्रीय)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================
# ⚠️ सिर्फ़ टेस्टिंग के लिए — असली लॉन्च से पहले हटाना अनिवार्य
# ============================================================
# true करने पर:
#   • OTP API जवाब में लौटता है (SMS gateway के बिना टेस्ट कर सकें)
#   • डेमो पासवर्ड (Admin@123, Officer@123 आदि) से लॉगिन चलता रहेगा
#
# इसके चालू रहते कोई भी व्यक्ति किसी का भी OTP माँगकर उसके खाते में
# घुस सकता है। असली उपयोगकर्ताओं के लिए खोलने से पहले हटाएं:
#   railway variables --unset ALLOW_INSECURE_DEV_LOGIN
ALLOW_INSECURE_DEV_LOGIN=

# 🆕 Activity Log Retention (वैकल्पिक) — कितने दिन तक पुराने activity_logs (login,
# logout, हर कार्रवाई) रखने हैं, फिर अपने-आप हट जाएं। डिफ़ॉल्ट 365 दिन (1 साल)।
# ACTIVITY_LOG_RETENTION_DAYS=365

# 🆕 Location Trail Retention (वैकल्पिक) — बंद हो चुकी शिकायतों का GPS रास्ता
# (complaint_location_trail) कितने दिन बाद अपने-आप हट जाए। डिफ़ॉल्ट 90 दिन।
# activity_logs (365) से जान-बूझकर कम — GPS-रास्ता कहीं ज़्यादा संवेदनशील डेटा है,
# और DPDP का सिद्धांत है कि व्यक्तिगत डेटा उतना ही समय रखा जाए जितना ज़रूरी हो।
# चालू (खुले) मामलों का रास्ता कभी नहीं हटता, चाहे कितना भी पुराना हो।
# LOCATION_TRAIL_RETENTION_DAYS=90

# AWS Secrets Manager — production में .env की जगह इस्तेमाल करने के लिए (वैकल्पिक)
# सिर्फ़ यही एक variable AWS पर सेट करें — बाक़ी सभी keys (ऊपर वाली सारी) वहां
# Secrets Manager में एक JSON secret के रूप में रहती हैं। स्थानीय विकास/Railway
# जैसी जगहों पर इसे खाली छोड़ दें — सब कुछ हमेशा की तरह ऊपर के .env से चलेगा।
# SECRETS_MANAGER_SECRET_NAME=
# AWS_REGION=ap-south-1

# ============================================================
# ⚖️ Load balancer / एक से ज़्यादा instance वाली तैनाती के लिए
# ============================================================
# सिर्फ़ एक instance चल रहा हो तो नीचे दोनों को खाली छोड़ दें — सब पहले जैसा चलेगा।

# साझा rate-limit गिनती (Redis) — एक से ज़्यादा instance पर ज़रूरी।
# इसके बिना हर instance अपनी अलग गिनती रखता है, यानी "10 लॉगिन कोशिश" वाली सीमा
# 3 instance पर असल में 30 हो जाती है — brute-force सुरक्षा उतनी ही कमज़ोर।
REDIS_URL=

# पृष्ठभूमि-कार्य (escalation, स्वचालित रिपोर्ट, सफ़ाई) — ये हर instance पर अलग
# चलते हैं, इसलिए एक से ज़्यादा instance पर सिर्फ़ *एक* पर true रखें, बाक़ी पर false।
# वरना escalation की सूचना व स्वचालित रिपोर्ट हर instance से एक-एक बार जाएंगी।
# खाली छोड़ने पर डिफ़ॉल्ट = चालू (single-instance के लिए सही)।
# RUN_SCHEDULERS=true

# डेमो खाते — सिर्फ़ इन नंबरों/यूज़रनेम के लिए डेमो-पासवर्ड चलते हैं और OTP API जवाब
# में लौटता है (ऐप दिखाते समय लॉगिन न अटके)। बाक़ी हर उपयोगकर्ता पर पूरी सुरक्षा रहती है।
# ⚠️ इन खातों में असली पीड़िताओं का डेटा कभी न रखें — ये जान-बूझकर कमज़ोर हैं।
# DEMO_ACCOUNTS=9999900001,demoadmin

# audit-log के hash की key। सेट न हो तो JWT_SECRET इस्तेमाल होता है।
# ⚠️ JWT_SECRET बदलने से *पहले* इसे JWT_SECRET के मौजूदा मान पर सेट करें — वरना
# पूरा पुराना audit-log असत्यापित हो जाएगा (उसके hash बेमेल हो जाएंगे)।
# AUDIT_HMAC_KEY=

# ईमेल — Resend (HTTPS)। Railway बाहर जाने वाले SMTP ports (465/587) बंद रखता है,
# इसलिए वहाँ Gmail SMTP काम नहीं करता; Resend port 443 पर चलता है।
# RESEND_API_KEY=re_xxxxx
# अपना डोमेन सत्यापित किए बिना Resend सिर्फ़ आपके अपने खाते वाले ईमेल पर भेजता है।
# असली नागरिकों तक मेल भेजने के लिए डोमेन सत्यापित करके यह सेट करें:
# RESEND_FROM=ShaktiCop <noreply@your-domain.in>
