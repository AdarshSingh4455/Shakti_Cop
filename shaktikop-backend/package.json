{
  "name": "shaktikop-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "db:migrate": "node src/scripts/runMigrations.js",
    "db:migrate:dry-run": "node src/scripts/runMigrations.js --dry-run",
    "db:migrate:status": "node src/scripts/runMigrations.js --status",
    "db:indexes": "node src/scripts/runMigrations.js --file=scale_indexes.sql",
    "db:monitor-menu": "node src/scripts/runMigrations.js --file=monitor_analytics_menu.sql",
    "db:seed": "node -e \"const db = require('./src/config/db'); const fs = require('fs'); const sql = fs.readFileSync('src/db/seed.sql','utf8'); db.query(sql).then(() => { console.log('Seed applied successfully'); process.exit(0); }).catch(e => { console.error(e); process.exit(1); });\"",
    "db:encrypt-fields": "node src/scripts/encryptExistingFields.js",
    "db:geocode-stations": "node src/scripts/geocodePoliceStations.js",
    "audit:verify": "node src/scripts/verifyAuditLog.js",
    "admin:bootstrap": "node src/scripts/bootstrapSuperAdmin.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@sentry/node": "^8.9.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "fontkit": "^2.0.4",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5",
    "rate-limit-redis": "^4.2.0",
    "ioredis": "^5.4.1"
  }
}